# Atlas Foundry (TokenSpeed) - Environment Configuration Template
# Copy to .env and fill in values

# Application
APP_NAME=atlas-foundry
APP_VERSION=1.0.0
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Model Configuration
MODEL_NAME=Qwen/Qwen3-0.6B
MODEL_DTYPE=bfloat16
TENSOR_PARALLEL_SIZE=1

# LLM Provider (opt-in, for advisory explanations only)
# LLM_API_KEY=your-api-key-here
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Distributed Weight Transfer (NCCL)
NCCL_MASTER_ADDRESS=127.0.0.1
NCCL_MASTER_PORT=29511
WEIGHT_UPDATE_GROUP_NAME=weight_update_group

# OIDC Authentication (future phase)
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/atlas-foundry
# OIDC_CLIENT_ID=atlas-foundry
# OIDC_CLIENT_SECRET=your-client-secret

# Demo Mode (local-only, refuses in production)
DEMO_MODE=false